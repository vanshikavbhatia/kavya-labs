# Kavya Labs - Environment Configuration Template
# Copy this file to .env.local for local development

# NextAuth / Auth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_random_32_char_secret_key_here
AUTH_SECRET=generate_a_secure_random_32_char_secret_key_here

# Google OAuth Provider (Optional - Demo authentication works without these)
# To enable Google OAuth, provide credentials from Google Cloud Console:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
